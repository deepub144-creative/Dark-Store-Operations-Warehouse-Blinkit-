# Audit-X Assistant Environment Configuration (Copy to .env)
APP_ENV=development
AUDITX_DB_PATH=./data/auditx.db
GENERATED_DIR=./backend/generated
UPLOADS_DIR=./backend/uploads

LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_BACKEND=hybrid-local
GROUNDING_MIN_SCORE=0.38
FILES_SIGNING_SECRET=replace-with-32-char-random-secret
FILE_URL_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Gmail SMTP Order Notification Service (Dedicated Sender Account: auditxka44@gmail.com)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=auditxka44@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
NOTIFY_SECRET=your_secure_notify_secret_here

# Firebase Admin SDK (Server-Side)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend Order Notifications (Fallback Provider)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="AuditX <onboarding@resend.dev>"




# Audit-X Assistant Environment Configuration (Copy to .env)
APP_ENV=development
AUDITX_DB_PATH=./data/auditx.db
GENERATED_DIR=./backend/generated
UPLOADS_DIR=./backend/uploads

# Provider-agnostic LLM adapter: auto | anthropic | gemini | openai | ollama | local
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# RAG Backends: hybrid-local (zero external weights) | sentence-transformers
EMBEDDING_BACKEND=hybrid-local
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_HF_CROSS_ENCODER=false
GROUNDING_MIN_SCORE=0.38

# Security, File URL Signing & Rate Limiting
FILES_SIGNING_SECRET=replace-with-32-char-random-secret
FILE_URL_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000


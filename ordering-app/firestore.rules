rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hub state, atomic inventory, movement ledger, reservations, idempotency,
    // reconciliation flags, and user identities are strictly server-managed via Admin SDK.
    match /auditx_state/{hubId} {
      allow read: if false;
      allow write: if false;
    }

    match /store_stock/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /stock_reservations/{reservationId} {
      allow read, write: if false;
    }

    match /inventory_movements/{movementId} {
      allow read: if false;
      allow write: if false;
    }

    match /order_idempotency/{idemKey} {
      allow read, write: if false;
    }

    match /reconciliation_alerts/{alertId} {
      allow read: if false;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow read, write: if false;
    }

    // Orders: readable for live dashboards & customer tracking; writes happen atomically via Admin SDK API routes.
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Complaints: customers can read their own ticket status or submit; updates via Admin SDK APIs.
    match /complaints/{complaintId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Staff online/offline duty status: readable by manager dashboard; written via Admin SDK.
    match /staffStatus/{staffId} {
      allow read: if true;
      allow write: if false;
    }

    match /wallets/{walletId} {
      allow read: if true;
      allow write: if false;
    }

    // OTP verification docs: never exposed to direct client access.
    match /otps/{phone} {
      allow read, write: if false;
    }

    match /customer_otps/{phone} {
      allow read, write: if false;
    }
  }
}
